{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ByteStackExtractCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "kind",
          "key",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 6,
            "maxLength": 140
          },
          "category": {
            "type": "string",
            "enum": [
              "workflow",
              "convention",
              "rule",
              "knowledge"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "playbooks",
              "workflows",
              "references",
              "scripts"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "maxLength": 400
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "steps",
              "verification"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80
              },
              "use_when": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 240
                },
                "maxItems": 10
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 400
                },
                "minItems": 1,
                "maxItems": 15
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 240
                },
                "minItems": 1,
                "maxItems": 10
              },
              "guardrails": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 240
                },
                "maxItems": 10
              }
            }
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "executable": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "playbooks",
                    "workflows"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "payload"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "content"
                    ]
                  },
                  {
                    "required": [
                      "executable"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "playbooks"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "required": [
                    "use_when"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "references"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "content"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "payload"
                    ]
                  },
                  {
                    "required": [
                      "executable"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scripts"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "content"
              ],
              "not": {
                "required": [
                  "payload"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
