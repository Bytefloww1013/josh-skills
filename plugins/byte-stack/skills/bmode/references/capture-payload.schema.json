{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ByteStackCapturePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "key",
    "title",
    "steps",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": ["playbooks", "workflows"]
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*\\.md$",
      "minLength": 4,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "use_when": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      },
      "maxItems": 10
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 400
      },
      "minItems": 1,
      "maxItems": 15
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      },
      "minItems": 1,
      "maxItems": 10
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      },
      "maxItems": 10
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": { "const": "playbooks" }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["use_when"]
      }
    }
  ]
}
