{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_pr_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
